<Window x:Class="_2026_WpfApp4.MyDocument"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:_2026_WpfApp4"
        mc:Ignorable="d"
        Title="MyDocument" Height="450" Width="800">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="NewCommand_Executed"/>
        <CommandBinding Command="ApplicationCommands.Open" Executed="OpenCommand_Executed"/>
        <CommandBinding Command="ApplicationCommands.Save" Executed="SaveCommand_Executed"/>
    </Window.CommandBindings>
    <DockPanel VerticalAlignment="Top">
        <ToolBarTray Height="40" Width="800" VerticalAlignment="Top" HorizontalAlignment="Left" DockPanel.Dock="Top" Background="Aqua">
            <ToolBar x:Name="FileToolbar" Height="42" Width="180" Background="Beige">
                <Button x:Name="NewfileButton" Width="38" Height="38" Command="ApplicationCommands.New">
                    <Image Width="32" Height="32" Source="C:\Users\owner\source\repos\2026_WpfApp4\2026_WpfApp4\new.png"/>
                </Button>
                <Button x:Name="OpenfileButton" Width="38" Height="38" Command="ApplicationCommands.Open">
                    <Image Width="32" Height="32" Source="C:\Users\owner\source\repos\2026_WpfApp4\2026_WpfApp4\open.png"/>
                </Button>
                <Button x:Name="SavefileButton" Width="38" Height="38" Command="ApplicationCommands.Save">
                    <Image Width="32" Height="32" Source="C:\Users\owner\source\repos\2026_WpfApp4\2026_WpfApp4\save.png"/>
                </Button>
                <Button x:Name="DeleteButton" Width="38" Height="38">
                    <Image Width="32" Height="32" Source="C:\Users\owner\source\repos\2026_WpfApp4\2026_WpfApp4\trash.png"/>
                </Button>
            </ToolBar>
            <ToolBar x:Name="EditingToolbar" Height="40" Width="612" Background="#FFEEDDAC">
                <ToggleButton x:Name="BoldButton">
                    <Image Width="32" Height="32" Source="C:\Users\owner\source\repos\2026_WpfApp4\2026_WpfApp4\bold.png"/>
                </ToggleButton>
                <ToggleButton x:Name="ItalicButton">
                    <Image Width="32" Height="32" Source="C:\Users\owner\source\repos\2026_WpfApp4\2026_WpfApp4\italic.png"/>
                </ToggleButton>
                <ToggleButton x:Name="UnderlineButton">
                    <Image Width="32" Height="32" Source="C:\Users\owner\source\repos\2026_WpfApp4\2026_WpfApp4\underline.png"/>
                </ToggleButton>
                <xctk:ColorPicker x:Name="FontColorPicker" Width="160" Height="35"/>
                <ComboBox x:Name="FontFamilyComboBox" HorizontalAlignment="Left" VerticalAlignment="Center" Width="150" Height="35" Margin="5,0,0,0"/>
                <ComboBox x:Name="FontSizeComboBox" HorizontalAlignment="Left" VerticalAlignment="Center" Width="50" Height="35" Margin="5,0,0,0"/>
            </ToolBar>
        </ToolBarTray>
        <StatusBar Height="395" DockPanel.Dock="Bottom" Background="LightGray"/>
        <RichTextBox x:Name="MainRichTextBox" Background="#FFEFEFEC">
            <FlowDocument/>
        </RichTextBox>
    </DockPanel>
</Window>
